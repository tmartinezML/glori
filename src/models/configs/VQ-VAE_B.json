{
    "model_name": "VQ-VAE-256-DR3opt",
    "model_class": "VQVAE",
    "dataset": "micromaps-DR3-opt-1024",
    "dataset_lookup": "MICROMAP_SUBSETS_ARROW_HOPPER",
    "image_size": 256,
    "max_beam_arcsec": 6,
    "scaler": "LOFAR_scaler_II",
    "image_channels": 1,
    "z_channels": 3,
    "emb_dim": 3,
    "n_embed": 2048,
    "init_channels": 128,
    "channel_mults": [
        1,
        2,
        4
    ],
    "norm_groups": 32,
    "attention_levels": 0,
    "attention_heads": 2,
    "attention_head_channels": 32,
    "dropout": 0,
    "batch_size": 14,
    "accumulate_grad_batches": 1,
    "devices": [
        0
    ],
    "iterations": 400000,
    "lr": 5e-06,
    "lr_disc": 2e-05,
    "pixel_loss": "l1",
    "pixelloss_weight": 1,
    "unsc_pixel_weight": 1e2,
    "codebook_weight": 1,
    "codebook_start": 0,
    "vq_kwargs": {
        "beta": 0.9,
        "kmeans_init": true,
        "affine_lr": 10,
        "sync_nu": 0.2,
        "replace_freq": 20,
        "cb_norm": "none",
        "norm": "bn",
        "distance_fn": "euclidean"
    },
    "disc_loss": "hinge",
    "disc_weight": 0.5,
    "disc_iter_start": 10000,
    "pretrain_disc": false,
    "dynamic_freezing": false,
    "disc_update_rate": 1,
    "disc_num_layers": 3,
    "disc_norm": "instance",
    "disc_hpf_sigma": 0.0,
    "log_interval": 1,
    "snapshot_interval": 1000,
    "val_every": 500,
    "val_batches": 64,
    "override_files": false,
    "pickup": true,
    "weights_only": false,
    "checkpoint": "last",
    "tune_lr": false,
    "train_mode": "standard",
    "overfit_batch": false,
    "train_img_log_interval": 20
}