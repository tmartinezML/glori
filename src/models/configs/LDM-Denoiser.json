        "scheduler_settings": {},
        "ema_rate": null,
        "ema_warmup_steps": 10000,
        "P_mean": -1.2,
        "P_std": 1.2,
        "snapshot_interval": 2000,
        "log_interval": 1,
        "val_every": 200,
        "val_batches": 64,
        "validate_ema": true,
        "devices": [
            1
        ],
        "random_crop": 128,
        "crop_fctxt": 1,
        "use_mask": true
    }
}