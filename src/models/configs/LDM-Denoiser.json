{
    "model_name": "LDM-Denoiser-CC-128",
    "model_class": "Denoiser",
    "backbone": "Unet",
    "dataset": "micromap-encodings-DR3-1024",
    "weights_file": null,
    "weights_fn": "lambda p: p.item()",
    "override_files": true,
    "pickup": false,
    "weights_only": false,
    "checkpoint": "last",
    "tune_lr": false,
    "overfit_batch": false,
