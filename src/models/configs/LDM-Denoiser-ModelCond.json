{
    "model_name": "LDM-Denoiser-MC-32",
    "model_class": "Denoiser",
    "backbone": "Unet",
    "dataset": "micromap-encodings-256",
    "override_files": true,
    "pickup": false,
    "weights_only": false,
    "checkpoint": "last",
    "tune_lr": false,
    "overfit_batch": false,
    "img_context": "pybdsf_model.npy",
    "ctxt_transform": {
        "pybdsf_model.npy": "ModelContextTransform"
    },
    "model_config" : {
        "image_channels": 8,
        "out_channels": 3,
        "init_channels": 128,
        "channel_mults": [
            1,
            2,
            2
        ],
        "norm_groups": 32,
        "attention_levels": 2,
        "attention_heads": 4,
        "attention_head_channels": 32,
        "sigma_data": 0.5,
        "dropout": 0.1,
        "context_dropout": 0.0
    },
    "train_config": {
        "batch_size": 256,
        "iterations": 200000,
        "learning_rate": 5e-5,
        "scheduler": null,
        "scheduler_kwargs": {},
        "scheduler_settings": {},
        "ema_rate": 0.99999,
        "ema_warmup_steps": 10000,
        "P_mean": -1.2,
        "P_std": 1.2,
        "snapshot_interval": 2000,
        "log_interval": 1,
        "val_every": 200,
        "val_batches": 64,
        "validate_ema": true,
        "devices": [
            1
        ],
        "random_crop": 32,
        "use_mask": true,
        "missing_is_error": false
    }
}